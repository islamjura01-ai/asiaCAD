# AsiaCAD — namuna: uchastka bosh rejasi (GUI skrinshotlari uchun ham ishlatiladi)
LAYER CHEGARA 1
LAYER BINO 5
LAYER YOL 30
LAYER DARAXT 3
LAYER NUQTA 2
LAYER YOZUV 7
LAYER SHTRIX 8
LAYER OLCHAM 6

CLAYER CHEGARA
PLINE 0,0 160,0 160,110 0,110 CLOSE

CLAYER YOL
PLINE -20,-14 180,-14
PLINE -20,-4 180,-4
LINE -20,-9 180,-9
ARC 160,-4 168,4 172,20
ARC 160,-14 176,-2 182,20

CLAYER BINO
PLINE 20,20 70,20 70,55 20,55 CLOSE
PLINE 90,20 140,20 140,45 115,45 115,60 90,60 CLOSE
CIRCLE 130,85 9
CIRCLE 130,85 6
CLAYER SHTRIX
HATCH 7 ANSI31 1 45
HATCH 8 SOLID

CLAYER DARAXT
CIRCLE 0,0 2.5
LINE -1.8,0 1.8,0
LINE 0,-1.8 0,1.8
BLOCK DARAXT 0,0 13-15
INSERT DARAXT 10,70
INSERT DARAXT 22,80 1.2
INSERT DARAXT 36,72
INSERT DARAXT 50,84 0.9
INSERT DARAXT 64,74 1.1
INSERT DARAXT 80,90
INSERT DARAXT 100,98 1.3
INSERT DARAXT 10,95

CLAYER NUQTA
POINT 0,0 160,0 160,110 0,110 45,37 115,40

CLAYER YOZUV
TEXT 2,114 4 "Uchastka №12 — Yunusobod tumani"
TEXT 45,37.5 2.6 "Bino A · 5 qavat" 0
TEXT 100,30 2.6 "Bino B" 0
TEXT 122,72 2 "Favvora"
TEXT 60,-12.5 2 "Navoiy koʻchasi"
CLAYER OLCHAM
DIMLINEAR 0,0 160,0 80,-24
DIMLINEAR 0,0 0,110 -12,55
DIMLINEAR 20,55 70,55 45,62
DIMLINEAR 20,20 20,55 13,37
DIMLINEAR 90,60 115,60 102,66
DIMALIGNED 140,45 115,45 128,50
DIMDIAMETER PICK:139,85 150,96
DIMRADIUS PICK:136,85 126,88
CLAYER 0
SAVE examples/uchastka.acad
